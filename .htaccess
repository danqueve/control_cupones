# Control de Cupones — control.imperiocomercial.com.ar

Options -Indexes
DirectoryIndex index.php

# API /api/v1: que el token (Authorization: Bearer ...) llegue a PHP.
# Con PHP como CGI/FPM/LSAPI, Apache no lo pasa por defecto y la API
# respondería 401 "Falta el token" aunque SAS lo mande bien.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .+
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Siempre por HTTPS (salvo en la PC local: XAMPP / WAMP)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|192\.168\.|10\.)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Carpetas internas: nunca accesibles desde la web
  RewriteRule ^(app|bin|sql|apps-script|logs)(/|$) - [F,L]
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule \.(md|sql|log|example\.php)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
